{
  "name": "mopani-web",
  "version": "0.1.0",
  "private": true,
  "description": "Mopani Corridor web app (increment 1: foundation). Pilot build. Payments are off.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "tinypool": "2.1.2"
  }
}
